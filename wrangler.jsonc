{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smrod-miekinia",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "f4563a4c1efb400d8856f3baf1146360",
		},
	],
	"observability": {
		"enabled": true,
	},
}
