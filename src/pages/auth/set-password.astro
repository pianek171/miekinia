---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
---

<Layout title="Set password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Set your password
      </h1>
      <p class="mb-6 text-center text-sm text-blue-100/70">Choose a password for {user?.email ?? "your account"}.</p>
      {error && <p class="mb-4 rounded-lg border border-red-300/30 bg-red-950/30 p-3 text-sm text-red-100">{error}</p>}
      <form method="POST" action="/api/auth/set-password" class="space-y-4">
        <label class="block text-sm text-blue-100/80" for="password">
          New password
          <input
            id="password"
            name="password"
            type="password"
            minlength="8"
            required
            autocomplete="new-password"
            class="mt-2 w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white outline-none focus:border-purple-300"
          />
        </label>
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Save password
        </button>
      </form>
    </div>
  </div>
</Layout>
